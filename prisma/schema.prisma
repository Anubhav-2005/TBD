generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  ARCHIVED
}
enum ProjectStatus {
  LEAD
  DISCOVERY
  PLANNING
  IN_PROGRESS
  IN_REVIEW
  ON_HOLD
  COMPLETED
  CANCELLED
}
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  UNCOLLECTIBLE
}
enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}
enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CLIENT
  RESOLVED
  CLOSED
}
enum LeadStatus {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}
enum FileVisibility {
  PRIVATE
  INTERNAL
  CLIENT
}
enum NotificationChannel {
  IN_APP
  EMAIL
}

model Organization {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  logoUrl       String?
  timezone      String        @default("Asia/Kolkata")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  users         User[]
  clients       Client[]
  projects      Project[]
  services      Service[]
  roles         Role[]
  settings      Setting[]
  media         Media[]
  categories    Category[]
  tags          Tag[]
  invoices      Invoice[]
  leads         Lead[]
  appointments  Appointment[]
  contactForms  ContactForm[]
  newsletter    NewsletterSubscriber[]
  auditLogs     AuditLog[]
  activities    Activity[]
  blogPosts     BlogPost[]
  portfolio     PortfolioItem[]
  testimonials  Testimonial[]
  faqs          FAQ[]
  @@index([slug])
}

model User {
  id            String       @id @default(cuid())
  organizationId String
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  status        UserStatus   @default(INVITED)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accounts      Account[]
  sessions      Session[]
  memberships   UserRole[]
  clientContact ClientContact?
  assignedTasks Task[]       @relation("TaskAssignee")
  taskReporter  Task[]       @relation("TaskReporter")
  meetings      Meeting[]    @relation("MeetingOrganizer")
  meetingAttendance MeetingAttendee[]
  notifications Notification[]
  messages      Message[]
  uploads       File[]       @relation("FileUploader")
  auditLogs     AuditLog[]
  activities    Activity[]
  blogPosts     BlogPost[]
  @@index([organizationId, status])
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Role {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isSystem       Boolean       @default(false)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  users          UserRole[]
  @@unique([organizationId, name])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  legalName      String?
  email          String?
  phone          String?
  website        String?
  billingAddress Json?
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       ClientContact[]
  projects       Project[]
  invoices       Invoice[]
  leads          Lead[]
  tickets        SupportTicket[]
  @@index([organizationId, name])
}

model ClientContact {
  id       String @id @default(cuid())
  clientId String
  userId   String? @unique
  name     String
  email    String
  title    String?
  isPrimary Boolean @default(false)
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user     User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@unique([clientId, email])
}

model Service {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?      @db.Text
  isActive       Boolean      @default(true)
  basePrice      Decimal?     @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects       ProjectService[]
  @@unique([organizationId, slug])
}

model Project {
  id             String        @id @default(cuid())
  organizationId String
  clientId       String
  name           String
  slug           String
  description    String?       @db.Text
  status         ProjectStatus @default(LEAD)
  priority       Priority      @default(MEDIUM)
  budget         Decimal?      @db.Decimal(12, 2)
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  services       ProjectService[]
  tasks          Task[]
  meetings       Meeting[]
  files          File[]
  messages       Message[]
  invoices       Invoice[]
  portfolio      PortfolioItem?
  @@unique([organizationId, slug])
  @@index([organizationId, clientId, status])
}

model ProjectService {
  projectId String
  serviceId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  @@id([projectId, serviceId])
}

model Task {
  id          String   @id @default(cuid())
  projectId   String
  assigneeId  String?
  reporterId  String
  parentId    String?
  title       String
  description String?  @db.Text
  status      String   @default("TODO")
  priority    Priority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  position    Float    @default(0)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter    User     @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  parent      Task?    @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Task[]   @relation("TaskHierarchy")
  @@index([projectId, status, position])
}

model Meeting {
  id          String   @id @default(cuid())
  projectId   String?
  organizerId String
  title       String
  startsAt    DateTime
  endsAt      DateTime
  location    String?
  notes       String?  @db.Text
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  organizer   User     @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  attendees   MeetingAttendee[]
  @@index([organizerId, startsAt])
}

model MeetingAttendee {
  meetingId String
  userId    String
  status    String @default("PENDING")
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([meetingId, userId])
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  clientId       String
  projectId      String?
  number         String
  status         InvoiceStatus @default(DRAFT)
  currency       String        @default("INR")
  subtotal       Decimal       @db.Decimal(12, 2)
  taxTotal       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  dueDate        DateTime?
  issuedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lineItems      InvoiceLineItem[]
  payments       Payment[]
  @@unique([organizationId, number])
  @@index([organizationId, clientId, status])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  total       Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String
  provider        String
  providerPaymentId String?     @unique
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  metadata        Json?
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  @@index([invoiceId, status])
}

model File {
  id          String         @id @default(cuid())
  projectId   String?
  uploaderId  String
  name        String
  mimeType    String
  size        Int
  storageKey  String         @unique
  url         String
  visibility  FileVisibility @default(INTERNAL)
  createdAt   DateTime       @default(now())
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader    User           @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  media       Media?
  @@index([projectId, visibility])
}

model Message {
  id          String   @id @default(cuid())
  projectId   String?
  senderId    String
  body        String   @db.Text
  createdAt   DateTime @default(now())
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender      User     @relation(fields: [senderId], references: [id], onDelete: Restrict)
  @@index([projectId, createdAt])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel @default(IN_APP)
  type      String
  title     String
  body      String?             @db.Text
  href      String?
  readAt    DateTime?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}

model BlogPost {
  id            String     @id @default(cuid())
  organizationId String
  authorId      String
  title         String
  slug          String
  excerpt       String?    @db.Text
  content       String     @db.Text
  publishedAt   DateTime?
  seo           Json?
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author        User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  tags          BlogTag[]
  @@unique([organizationId, slug])
}

model PortfolioItem {
  id            String       @id @default(cuid())
  organizationId String
  projectId     String?      @unique
  title         String
  slug          String
  summary       String?      @db.Text
  content       String?      @db.Text
  publishedAt   DateTime?
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  @@unique([organizationId, slug])
}

model Testimonial {
  id            String       @id @default(cuid())
  organizationId String
  name          String
  company       String?
  quote         String       @db.Text
  rating        Int?
  isPublished   Boolean      @default(false)
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  clientId       String?
  name           String
  email          String
  company        String?
  source         String?
  status         LeadStatus   @default(NEW)
  value          Decimal?     @db.Decimal(12, 2)
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  @@index([organizationId, status, createdAt])
}

model SupportTicket {
  id        String       @id @default(cuid())
  clientId  String
  subject   String
  body      String       @db.Text
  status    TicketStatus @default(OPEN)
  priority  Priority     @default(MEDIUM)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  @@index([clientId, status])
}

model Media {
  id             String       @id @default(cuid())
  organizationId String
  fileId         String       @unique
  alt            String?
  width          Int?
  height         Int?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  file           File         @relation(fields: [fileId], references: [id], onDelete: Cascade)
}

model Category {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  slug           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, slug])
}

model Tag {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  slug           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  blogs          BlogTag[]
  @@unique([organizationId, slug])
}

model BlogTag {
  blogPostId String
  tagId      String
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([blogPostId, tagId])
}

model FAQ {
  id             String       @id @default(cuid())
  organizationId String
  question       String
  answer         String       @db.Text
  position       Int          @default(0)
  isPublished    Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, position])
}

model NewsletterSubscriber {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  status         String       @default("PENDING")
  subscribedAt   DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, email])
}

model ContactForm {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  email          String
  message        String       @db.Text
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Appointment {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  email          String
  startsAt       DateTime
  endsAt         DateTime
  status         String       @default("REQUESTED")
  notes          String?      @db.Text
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, startsAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  actorId   String?
  anonymousId String?
  properties Json?
  occurredAt DateTime @default(now())
  @@index([name, occurredAt])
}

model Setting {
  id             String       @id @default(cuid())
  organizationId String
  key            String
  value          Json
  isSecret       Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, key])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ipHash         String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([organizationId, entityType, entityId, createdAt])
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String?
  type           String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([organizationId, entityType, entityId, createdAt])
}
